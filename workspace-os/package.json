{
  "name": "workspace-os",
  "version": "0.1.0",
  "description": "Kişisel Workspace OS — dosyaları, sürücüleri, ofis ve AI araçlarını tek ekosistemde birleştiren masaüstü uygulaması",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.workspaceos.app",
    "productName": "Workspace OS",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "docx": "^9.8.1",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "image-size": "^2.0.4"
  }
}
